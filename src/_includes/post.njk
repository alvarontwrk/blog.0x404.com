---
layout: base.njk
---
<article class="post">
  <p class="back-link"><a href="/">← Posts</a></p>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">{{ date | postDate }}</p>
    {% if description %}<p class="post-description">{{ description }}</p>{% endif %}
  </header>

  <div class="post-body prose">
    {{ content | safe }}
  </div>

  <p class="post-signature">- {{ site.author }}</p>
</article>
